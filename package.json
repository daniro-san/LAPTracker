{
  "name": "laptracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "prettier --check . && eslint . && tsc --noEmit && vitest run && tsx scripts/check-drift.ts && tsx scripts/i18n-check.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "snapshot:dry": "tsx scripts/snapshot-dry.ts",
    "i18n:todo": "tsx scripts/i18n-check.ts --todo",
    "i18n:stamp": "tsx scripts/i18n-check.ts --stamp",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "db:local:start": "node --env-file-if-exists=.env.local scripts/db-local.mjs start",
    "db:local:stop": "node --env-file-if-exists=.env.local scripts/db-local.mjs stop",
    "db:local:migrate": "node --env-file-if-exists=.env.local scripts/db-local.mjs migrate",
    "db:local:bridge": "node --env-file-if-exists=.env.local scripts/db-local-bridge.mjs",
    "db:local:seed": "node --env-file-if-exists=.env.local scripts/db-local.mjs check && tsx --env-file-if-exists=.env.local --import ./scripts/db-local-preload.mjs scripts/seed.ts",
    "dev:local": "NODE_OPTIONS='--import ./scripts/db-local-preload.mjs' next dev",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "drizzle-orm": "0.45.4",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "eslint-plugin-import-x": "4.17.1",
    "fast-check": "4.10.2",
    "lefthook": "2.2.2",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "ws": "8.22.1"
  }
}
