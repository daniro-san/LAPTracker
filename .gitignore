# secrets — every .env file except the template
.env*
!.env.example

# dependencies and build output
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo
coverage/

# e2e suite output (pnpm test:e2e)
test-results/
playwright-report/

# local Postgres cluster (pnpm db:local:start)
.pglocal/

# Claude Code local state
.claude/worktrees/
.claude/settings.local.json

# OS
.DS_Store

# Python bytecode from docs/brand/drawing/build.py
__pycache__/

# tlc-spec-lean captures and screenshots stay local (.specs/README.md)
.specs/**/*.[pP][nN][gG]
.specs/**/*.[jJ][pP][gG]
.specs/**/*.[jJ][pP][eE][gG]
.specs/**/*.[wW][eE][bB][pP]
.specs/**/*.[gG][iI][fF]
