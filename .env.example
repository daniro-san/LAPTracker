# Copy to .env.local (gitignored) for local work; set the same names in Vercel.
# Never commit values. Meaning of each: IMPLEMENTATION_PLAN.md §7, PREREQUISITES.md §4.

# Secrets
LAP_API_KEY=
DATABASE_URL=
CRON_SECRET=
EDIT_PIN=
NOTIFY_WEBHOOK_PUBLIC=
NOTIFY_WEBHOOK_ADMIN=
NOTIFY_ADMIN_MENTION=

# Upstream (optional; defaults in lib/env.ts, plan §7)
LAP_API_BASE_URL=
LAP_SITE_BASE_URL=

# Schedule (server time; the server runs at UTC−2, POSIX sign inverted: Etc/GMT+2)
SERVER_TZ=
EVENT_WEEKDAY=
EVENT_TIME=
SNAPSHOT_BEFORE=
SNAPSHOT_AFTER=
SNAPSHOT_WINDOW_MIN=
QUOTA_CHECK_AT=

# Deploy (APP_URL is a GitHub repository secret; ENABLE_EXPERIMENTAL_COREPACK is a Vercel env var)
APP_URL=
ENABLE_EXPERIMENTAL_COREPACK=
