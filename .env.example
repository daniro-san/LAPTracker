# The owner copies this to .env.local (gitignored) for local work. Vercel uses the same names with its own values, never these.
# Never commit values. Meaning of each: IMPLEMENTATION_PLAN.md §7, PREREQUISITES.md §4.
# The values below are local placeholders: with them the app runs on `pnpm db:local` and reaches no outside
# service (CONTRIBUTING.md, "Local setup without production secrets"). Never put a real value here.

# Required (lib/env.ts stops the server without them); local placeholders, not secrets
# Upstream API key; a placeholder is enough, because the base URLs below point at 127.0.0.1:9.
LAP_API_KEY=lap_local-placeholder
# Postgres URL; this one is the local cluster that `pnpm db:local:start` creates. Never a Neon URL here.
DATABASE_URL=postgres://lap:lap@127.0.0.1:54320/laptracker
# Shared secret of the cron routes, 32+ characters; any local string.
CRON_SECRET=local-placeholder-cron-secret-0123456789
# The /admin PIN, 6-64 visible ASCII characters; a local one, never the production PIN.
EDIT_PIN=000000

# Database (optional)
# Direct (unpooled) URL for `pnpm db:migrate` only; empty: DATABASE_URL is used.
DATABASE_URL_UNPOOLED=
# Port of the `pnpm db:local:bridge` WebSocket bridge (default 54321).
DB_LOCAL_BRIDGE_PORT=54321

# Outside services' base URLs (optional; defaults in lib/env.ts). 127.0.0.1:9: nothing answers, nothing is sent.
# Upstream API (default https://api.lastasylumtracker.com/v1).
LAP_API_BASE_URL=http://127.0.0.1:9/v1
# Upstream site (default https://lastasylumtracker.com/api).
LAP_SITE_BASE_URL=http://127.0.0.1:9/api
# Discord's API for the workspace sign-in (default https://discord.com/api).
DISCORD_API_BASE_URL=http://127.0.0.1:9/discord
# PostHog's API for the usage numbers (default PostHog's US app).
POSTHOG_API_BASE_URL=http://127.0.0.1:9/posthog

# Discord messages (optional; secrets, empty locally)
# Public channel webhook; empty: no public messages.
NOTIFY_WEBHOOK_PUBLIC=
# Admin channel webhook; empty: no admin messages.
NOTIFY_WEBHOOK_ADMIN=
# Who the admin messages mention: <id> or role:<id>.
NOTIFY_ADMIN_MENTION=

# Workspace sign-in (D71; optional; README "Workspace setup"). Empty: /w/<slug> says sign-in is not set up.
# The Discord application's Client ID.
DISCORD_CLIENT_ID=
# The Discord application's Client Secret (a secret).
DISCORD_CLIENT_SECRET=
# "Send to LAPTracker" (D96): the app's Public Key, 64 hex characters; not a secret. Empty: interactions refused.
DISCORD_PUBLIC_KEY=
# "Translate for everyone" in a thread (D101; a secret): the bot token. Empty: translations go to the channel.
DISCORD_BOT_TOKEN=

# Schedule (server time; the server runs at UTC−2, POSIX sign inverted: Etc/GMT+2). Required.
# The server's IANA time zone.
SERVER_TZ=Etc/GMT+2
# The event's weekday, 0 = Sunday … 6 = Saturday.
EVENT_WEEKDAY=6
# The event's start, HH:MM.
EVENT_TIME=12:00
# The snapshot before the event, HH:MM.
SNAPSHOT_BEFORE=10:00
# The snapshot after the event, HH:MM.
SNAPSHOT_AFTER=14:00
# How many minutes after the scheduled minute a tick may still start a snapshot (1-240).
SNAPSHOT_WINDOW_MIN=45
# The weekly quota check posted to the admin channel, e.g. "fri 20:00".
QUOTA_CHECK_AT="fri 20:00"
# Weekly automatic rehearsals (default "fri 18:00"; comma-separated list; empty turns them off).
REHEARSAL_AT="fri 18:00"
# How many past rehearsals to keep (default 4).
REHEARSAL_KEEP=
# Minutes between an event's samples (D69), on a grid from the hour; default 15, 0 = off.
SAMPLE_EVERY_MIN=
# Daily roster read for member history (D60, D72), server time, every day; default 23:30.
DAILY_ROSTER_AT=

# PostHog (optional)
# Project API key (D77); public by design. Analytics only when VERCEL_ENV is "production"; flags (D91) wherever set.
POSTHOG_KEY=
# Personal API key for the build's source-map upload (D115; a secret, Vercel Production only). Empty: no source maps.
POSTHOG_PERSONAL_API_KEY=
# Personal API key, read-only query scope, for the usage numbers on /admin and the desk (D145; a secret).
POSTHOG_QUERY_API_KEY=
# Feature flags on without PostHog (D91), comma-separated, e.g. merge-simulator,chart-details; never on Vercel.
LOCAL_FLAGS=

# Notices (optional; secrets, empty locally)
# Groq key for Translate and Improve writing (D81). Empty: the buttons say they are not set up.
GROQ_API_KEY=
# "Publish to Discord" (D102): JSON by workspace slug, {"<slug>":{"members":{"url":"<webhook>","name":"<channel>","forum":true},"leaders":{...}}}.
WORKSPACE_DISCORD_WEBHOOKS=

# Workspace keys and notifications (optional; secrets, empty locally)
# Master key that encrypts each workspace's tracker key (D124): `openssl rand -base64 32`. Changing it voids saved keys.
WORKSPACE_KEYS_SECRET=
# Officers' browser notifications (D148): public key from `pnpm push:keys`; all three plus WORKSPACE_KEYS_SECRET turn them on.
VAPID_PUBLIC_KEY=
# The private key from `pnpm push:keys` (a secret).
VAPID_PRIVATE_KEY=
# A contact the push services may write to: mailto:… or https://….
VAPID_SUBJECT=

# Deploy (not read by the app)
# The production address the tick workflow calls; a GitHub repository secret.
APP_URL=
# Vercel env var that turns on Corepack for the pinned pnpm.
ENABLE_EXPERIMENTAL_COREPACK=

# Dev only: "1" renders every lib/copy.ts value as ░ for the ten-second test (plan Phase 5f); inert in production.
NEXT_PUBLIC_BLANK_COPY=

# Not set here: VERCEL_ENV, VERCEL_DEPLOYMENT_ID and VERCEL_GIT_* (Vercel sets them), and the test opt-ins
# LAP_LIVE_TEST (spends API quota), LAP_SMOKE_OUT and OCR_TEST, given on the command line when needed.
