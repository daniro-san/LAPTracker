# Copy to .env.local (gitignored) for local work; set the same names in Vercel.
# Never commit values. Meaning of each: IMPLEMENTATION_PLAN.md §7, PREREQUISITES.md §4.

# Secrets
LAP_API_KEY=
DATABASE_URL=
CRON_SECRET=
EDIT_PIN=
NOTIFY_WEBHOOK_PUBLIC=
NOTIFY_WEBHOOK_ADMIN=
NOTIFY_ADMIN_MENTION=
# Workspace sign-in (D71; optional, the app starts without them). README "Workspace setup".
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# "Send to LAPTracker" (D96): the Discord app's Public Key (General Information), 64 hex characters. Not a secret.
DISCORD_PUBLIC_KEY=
# "Translate for everyone" in a thread (D101; optional, a secret): the app's bot token (Bot tab).
DISCORD_BOT_TOKEN=

# Upstream (optional; defaults in lib/env.ts, plan §7)
LAP_API_BASE_URL=
LAP_SITE_BASE_URL=
# Discord's API for the workspace sign-in (default https://discord.com/api; the local e2e points it at a stub)
DISCORD_API_BASE_URL=

# Schedule (server time; the server runs at UTC−2, POSIX sign inverted: Etc/GMT+2)
SERVER_TZ=
EVENT_WEEKDAY=
EVENT_TIME=
SNAPSHOT_BEFORE=
SNAPSHOT_AFTER=
SNAPSHOT_WINDOW_MIN=
QUOTA_CHECK_AT=
# Weekly automatic rehearsal (default "fri 18:00"; comma-separated list; set to empty to turn off)
# and how many past rehearsals to keep (default 4). Both optional.
REHEARSAL_AT="fri 18:00"
REHEARSAL_KEEP=
# Minutes between an event's samples (D69), on a grid from the hour; default 15, 0 = off.
SAMPLE_EVERY_MIN=
# Daily roster read for member history (D60), server time; default 23:30, so the 23:37 tick reads the
# day's counters before the 00:00 reset and the 23:52 tick re-reads what fell short (D72). Every day,
# event days included.
DAILY_ROSTER_AT=

# PostHog project API key (D77; optional). Public by design. Analytics only when VERCEL_ENV is "production";
# the feature flags (D91) are read wherever it is set, previews included.
POSTHOG_KEY=
# PostHog personal API key for the source-map upload at build time (D115; optional). Vercel only, Production,
# marked Sensitive; scope error_tracking:write. Without it the build makes no source maps and uploads nothing.
POSTHOG_PERSONAL_API_KEY=
# PostHog personal API key with read-only query scope on project 741657, for the usage numbers on /admin and
# the desk (D145; optional). Server only, Vercel Production, Sensitive. Never the source-map key above.
POSTHOG_QUERY_API_KEY=
# Feature flags on without PostHog (D91; local dev and reviews only): comma-separated keys, e.g.
# merge-simulator,chart-details,kill-vs-might,war-turnout. Read only when POSTHOG_KEY is not set;
# never set it on Vercel.
LOCAL_FLAGS=

# Groq key for the notices' Translate and Improve writing (D81; optional; a Vercel Sensitive variable).
GROQ_API_KEY=

# "Publish to Discord" for notices (D102; optional; a Vercel Sensitive variable): JSON by workspace slug,
# {"<slug>":{"members":{"url":"<webhook>","name":"<channel>","forum":true},"leaders":{...}}}.
WORKSPACE_DISCORD_WEBHOOKS=

# The master key that encrypts each workspace's own tracker key (D124; optional; a Vercel Sensitive
# variable): 32 bytes, base64, from `openssl rand -base64 32`. Unset: no workspace key is saved or used.
# Changing WORKSPACE_KEYS_SECRET makes every saved tracker key need to be entered again.
WORKSPACE_KEYS_SECRET=

# Deploy (APP_URL is a GitHub repository secret; ENABLE_EXPERIMENTAL_COREPACK is a Vercel env var)
APP_URL=
ENABLE_EXPERIMENTAL_COREPACK=

# Dev only: "1" renders every lib/copy.ts value as ░ for the ten-second test (plan Phase 5f). Inert in
# production builds; never set it on Vercel.
NEXT_PUBLIC_BLANK_COPY=
