# Runtime environment for LAPTracker. Copy to .env.local (gitignored) and fill in; never commit values.
# Every variable here is validated by lib/env.ts at server start (fails fast, names the bad keys, never prints values).
# Source of truth: docs/IMPLEMENTATION_PLAN.md §7 and docs/PREREQUISITES.md §4.

# Documented API key from the tracker's /account page. Used only by lib/sources/v1.ts.
LAP_API_KEY=
# Neon pooled connection string (postgres://...).
DATABASE_URL=
# Bearer secret for /api/tick and /api/snapshot; 32+ chars (openssl rand -hex 32).
CRON_SECRET=
# 6-8 digits; gates "Run snapshot now" on /admin.
EDIT_PIN=

# Schedule, all in server time. Change here and redeploy; no commit needed (plan §3.1).
# Server runs at UTC-2 fixed; the POSIX sign of Etc/GMT+2 is inverted on purpose.
SERVER_TZ=Etc/GMT+2
EVENT_WEEKDAY=6
EVENT_TIME=12:00
SNAPSHOT_BEFORE=10:00
SNAPSHOT_AFTER=14:00
SNAPSHOT_WINDOW_MIN=45
QUOTA_CHECK_AT="fri 20:00"

# Optional Discord notifications; each is skipped when empty.
NOTIFY_WEBHOOK_PUBLIC=
NOTIFY_WEBHOOK_ADMIN=
# Optional: a Discord user id (digits) or role:<id>.
NOTIFY_ADMIN_MENTION=

# Optional: set to 1 to run the opt-in live smoke test (spends 1 API call).
LAP_LIVE_TEST=

# Not app runtime variables, listed so nothing is forgotten:
#   APP_URL (GitHub repository secret, used by the tick workflow)
#   ENABLE_EXPERIMENTAL_COREPACK=1 (Vercel build env, so the build honours packageManager)
