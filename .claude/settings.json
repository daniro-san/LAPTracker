{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(git commit *)",
      "Bash(curl http://localhost:*)",
      "Bash(curl -s* http://localhost:*)",
      "Bash(curl http://127.0.0.1:*)",
      "Bash(curl -s* http://127.0.0.1:*)",
      "Bash(curl https://laptracker-inky.vercel.app/*)",
      "Bash(curl -s* https://laptracker-inky.vercel.app/*)",
      "Bash(gh api repos/daniro-san/LAPTracker/*)",
      "Bash(gh api --paginate repos/daniro-san/LAPTracker/*)",
      "Bash(gh api -X GET repos/daniro-san/LAPTracker/*)",
      "Bash(gh api --method GET repos/daniro-san/LAPTracker/*)",
      "Bash(gh api repos/{owner}/{repo}/*)",
      "Bash(gh api --paginate repos/{owner}/{repo}/*)",
      "Bash(gh api -X GET repos/{owner}/{repo}/*)",
      "Bash(gh issue view *)",
      "Bash(gh issue list*)",
      "Bash(gh workflow list*)",
      "Bash(gh workflow view *)",
      "Bash(gh workflow run release-prepare.yml*)",
      "Bash(gh api -X POST repos/daniro-san/LAPTracker/actions/runs/*/approve)",
      "Bash(gh workflow run e2e.yml --ref dev)",
      "Bash(git push -u origin HEAD)",
      "Bash(git push origin HEAD:refs/heads/*)",
      "Bash(git push --force-with-lease origin HEAD:refs/heads/*)",
      "Bash(git push -q --force-with-lease origin HEAD:refs/heads/*)",
      "Bash(gh pr create *)",
      "Bash(gh pr close*)",
      "Bash(gh pr view*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr list*)",
      "Bash(gh pr comment *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr ready*)",
      "Bash(gh pr merge * --squash*)",
      "Bash(gh pr merge --squash*)",
      "Bash(gh pr merge * --merge*)",
      "Bash(gh pr merge --merge*)",
      "Bash(gh release *)"
    ],
    "deny": [
      "Bash(git push origin main)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *:refs/heads/main)",
      "Bash(git push *:refs/heads/main *)",
      "Bash(git push * +main)",
      "Bash(git push * +main *)",
      "Bash(git push * refs/heads/main)",
      "Bash(git push * refs/heads/main *)",
      "Bash(git push * +refs/heads/main)",
      "Bash(git push * +refs/heads/main *)",
      "Bash(git push origin dev)",
      "Bash(git push * dev)",
      "Bash(git push * dev *)",
      "Bash(git push *:dev)",
      "Bash(git push *:dev *)",
      "Bash(git push *:refs/heads/dev)",
      "Bash(git push *:refs/heads/dev *)",
      "Bash(git push * +dev)",
      "Bash(git push * +dev *)",
      "Bash(git push * refs/heads/dev)",
      "Bash(git push * refs/heads/dev *)",
      "Bash(git push * +refs/heads/dev)",
      "Bash(git push * +refs/heads/dev *)",
      "Bash(git push *--all*)",
      "Bash(git push *--mirror*)",
      "Bash(gh pr create*--base main*)",
      "Bash(gh pr create*--base=main*)",
      "Bash(gh pr create*-B main*)",
      "Bash(gh pr create*-Bmain*)",
      "Bash(gh pr edit*--base main*)",
      "Bash(gh pr edit*--base=main*)",
      "Bash(gh pr edit*-B main*)",
      "Bash(gh pr edit*-Bmain*)",
      "Bash(gh pr merge*--admin*)",
      "Bash(gh api *base=main*)",
      "Bash(gh api *pulls/*/merge*)",
      "Bash(gh api *dispatches*)",
      "Bash(gh api *-X*PUT*)",
      "Bash(gh api *-X*PATCH*)",
      "Bash(gh api *-X*DELETE*)",
      "Bash(gh api *--method*PUT*)",
      "Bash(gh api *--method*PATCH*)",
      "Bash(gh api *--method*DELETE*)",
      "Bash(gh api *POST*pulls*)",
      "Bash(gh api *POST*merges*)",
      "Bash(gh api *POST*git/*)",
      "Bash(gh api *POST*contents*)",
      "Bash(gh api *POST*releases*)",
      "Bash(gh api *POST*branches*)",
      "Bash(gh api *POST*rulesets*)",
      "Bash(gh api *POST*hooks*)",
      "Bash(gh api graphql*mutation*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n)",
      "Bash(git commit * -n *)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify)",
      "Bash(git commit * --no-verify *)",
      "Bash(git *core.hooksPath*)",
      "Bash(*LEFTHOOK=0*)",
      "Bash(gh workflow run tick*)",
      "Bash(curl *api/quota*)",
      "Bash(curl *laptracker-inky.vercel.app/api/tick*)",
      "Bash(curl *laptracker-inky.vercel.app/api/snapshot*)",
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.local.*)",
      "Read(//**/.env.*.local)",
      "Read(//**/.env.dev*)",
      "Read(//**/.env.prod*)",
      "Read(//**/.env.preview*)",
      "Read(//**/.env.staging*)",
      "Read(//**/.env.test*)",
      "Read(//**/.env.vercel*)",
      "Read(//**/.env.bak*)",
      "Read(//**/.env.old*)",
      "Read(//**/.env.backup*)",
      "Read(//**/.env.copy*)",
      "Read(//**/.env.save*)",
      "Read(//**/.env~*)",
      "Bash(* .env)",
      "Bash(* .env *)",
      "Bash(*/.env)",
      "Bash(*/.env *)",
      "Bash(*.env.local*)",
      "Bash(*.env.dev*)",
      "Bash(*.env.prod*)",
      "Bash(*.env.preview*)",
      "Bash(*.env.staging*)",
      "Bash(*.env.test*)",
      "Bash(*.env.vercel*)",
      "Bash(*dotenv*)",
      "Bash(pnpm dlx*)",
      "Bash(pnpm exec node*)",
      "Bash(pnpm node*)",
      "Bash(pnpm*db:seed*)",
      "Bash(npm*db:seed*)",
      "Bash(*tsx *scripts/seed.ts*)",
      "Bash(*node *scripts/seed.ts*)",
      "Bash(pnpm*discord:register*)",
      "Bash(npm*discord:register*)",
      "Bash(*tsx *discord-register-command*)",
      "Bash(*node *discord-register-command*)",
      "Bash(pnpm drizzle-kit push*)",
      "Bash(pnpm exec drizzle-kit push*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(git reset --hard*)",
      "Bash(pnpm drizzle-kit drop*)",
      "Bash(pnpm exec drizzle-kit drop*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/install_pkgs.sh\"",
            "timeout": 300
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/pr-base-guard.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/env-guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/post-edit-lint.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/stop-check.sh\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
